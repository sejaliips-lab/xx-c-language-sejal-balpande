// bitwise oprators  
     #include <stdio.h>
int main () {

    int a=25;
    int b=5;
    int AND =a&b;
    int OR =a|b;
    int XOR =a^b;
    int LEFTSHIFT =a<<b;
    printf("the and gate  result of %d &%d is : %d\n ",a,b,AND);
    printf("the or gate result of %d &%d is : %d\n ",a,b,OR);
    printf("the xor gate result of %d &%d is : %d\n ",a,b,XOR);
    printf("the left shift result of %d &%d is : %d\n ",a,b,LEFTSHIFT) ;
    return 0;


}      